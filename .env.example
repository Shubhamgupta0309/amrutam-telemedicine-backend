# Application
PROJECT_NAME="Amrutam Telemedicine Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="amrutam-super-secret-key-change-in-production-min-32-chars-long!"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# For local SQLite quickstart: sqlite:///./amrutam.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/amrutam_telemedicine
DATABASE_URL="sqlite:///./amrutam.db"

# Redis Cache & Rate Limiting (Optional)
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_PER_MINUTE=60

# Observability
METRICS_ENABLED=true
OTEL_ENABLED=false

# Payment Webhook
PAYMENT_WEBHOOK_SECRET="mock-payment-hmac-secret-key-32chars"
